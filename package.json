{
  "name": "open-clip-editor",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Local YouTube and long-video clipping, captions and creator editing",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "node server/index.mjs",
    "clip": "node server/cli.mjs",
    "test": "node --test tests/*.test.mjs",
    "lint": "node scripts/lint.mjs",
    "build": "tsc -p web/tsconfig.json && vite build --config web/vite.config.ts",
    "dev": "node scripts/dev.mjs",
    "setup:faces": "node scripts/setup-faces.mjs",
    "package:source": "node scripts/package-source.mjs",
    "automate": "node scripts/automation-cli.mjs",
    "setup:references": "node scripts/prepare-references.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "archiver": "^7.0.1",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "lucide-react": "^1.66.0",
    "multer": "^2.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
