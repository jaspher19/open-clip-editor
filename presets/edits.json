  {
    "id": "meme-reveal",
    "name": "Meme Reveal",
    "category": "Meme edit · reveal",
    "group": "meme",
    "moment": {
      "label": "Reveal moment",
      "about": "Finds short 11–24 s moments where a jump cut lands right before the loudest reaction, and builds the edit around that reveal.",
      "play": [
        11,
        24
      ],
      "min": 10,
      "max": 32,
      "payoff": [
        0.5,
        0.8
      ],
      "cut": true
