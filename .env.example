# Optional paid AI. No key is required for the default heuristic picker or local metadata.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# "Write with AI" (YouTube titles, descriptions, hashtags, tags). Any one key enables it.
# Free: Gemini key from https://aistudio.google.com/app/apikey (no card needed).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Free backup: Groq key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Leave blank to use the first key set (Gemini, then Groq, then Claude), or pick gemini, groq or claude.
METADATA_AI=
# Paid Claude key from https://console.anthropic.com/ . Used for "Write with AI" (Claude Opus 5.5)
# when no free key is set or METADATA_AI=claude, and for the optional Anthropic clip picker.
ANTHROPIC_API_KEY=
# Model for the optional Anthropic clip picker only.
ANTHROPIC_MODEL=claude-sonnet-4-6
# Region for YouTube's trending chart used as title-style context (two-letter country code).
YOUTUBE_REGION=US
# Leave blank to use .venv inside this project.
CLIP_PYTHON=
PORT=5173
